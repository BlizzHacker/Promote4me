{
  "openapi": "3.1.0",
  "info": {
    "title": "Promote4.me Social Media Commander API",
    "description": "Multi-platform AI social media automation, scheduling calendar, comment management, auto-replies, and growth campaigns for Reddit, Facebook, Instagram, Twitter/X, Discord, YouTube, TikTok, Bluesky, Telegram.",
    "version": "4.0.0"
  },
  "servers": [
    {
      "url": "https://promote4.me",
      "description": "Promote4.me Production Server"
    },
    {
      "url": "http://192.168.0.151",
      "description": "Local Cluster Gateway"
    }
  ],
  "paths": {
    "/api/commander/status": {
      "get": {
        "operationId": "getCommanderStatus",
        "summary": "Check commander system status and active accounts",
        "responses": {
          "200": {
            "description": "Status overview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/commander/accounts": {
      "get": {
        "operationId": "listSocialAccounts",
        "summary": "List all connected social media accounts with follower counts and daily limits",
        "responses": {
          "200": {
            "description": "List of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "connectSocialAccount",
        "summary": "Connect or update credentials for a social platform (Reddit, FB, IG, Twitter/X, Discord, YouTube, TikTok)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "username"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "accountName": {
                    "type": "string"
                  },
                  "credentials": {
                    "type": "object"
                  },
                  "proxyUrl": {
                    "type": "string"
                  },
                  "dailyLimits": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connected account details"
          }
        }
      }
    },
    "/api/commander/post/now": {
      "post": {
        "operationId": "publishSocialPostNow",
        "summary": "Publish a post immediately to one or multiple social media platforms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "content"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "mediaUrls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetDestinations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Published post result with platform URL"
          }
        }
      }
    },
    "/api/commander/post/schedule": {
      "post": {
        "operationId": "scheduleSocialPost",
        "summary": "Schedule a post on the calendar with custom time or natural human slot with jitter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "content"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "scheduledAt": {
                    "type": "string"
                  },
                  "naturalSlot": {
                    "type": "boolean"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "mediaUrls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetDestinations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scheduled post confirmation"
          }
        }
      }
    },
    "/api/commander/calendar": {
      "get": {
        "operationId": "getSocialCalendar",
        "summary": "View social media calendar schedule, queue, and published history",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar posts list"
          }
        }
      }
    },
    "/api/commander/post/{id}": {
      "delete": {
        "operationId": "cancelScheduledPost",
        "summary": "Cancel or unschedule a post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled post status"
          }
        }
      }
    },
    "/api/commander/comments": {
      "get": {
        "operationId": "getSocialComments",
        "summary": "Retrieve comments across platforms for moderation or response",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of comments"
          }
        }
      }
    },
    "/api/commander/comments/reply": {
      "post": {
        "operationId": "replySocialComment",
        "summary": "Submit a reply to a comment on Reddit, Facebook, Instagram, Twitter, etc.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "commentId",
                  "replyText"
                ],
                "properties": {
                  "commentId": {
                    "type": "string"
                  },
                  "replyText": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replied comment status"
          }
        }
      }
    },
    "/api/commander/messages": {
      "get": {
        "operationId": "getSocialMessages",
        "summary": "Retrieve direct messages and conversations",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of messages"
          }
        }
      }
    },
    "/api/commander/messages/send": {
      "post": {
        "operationId": "sendSocialMessage",
        "summary": "Send a direct message or reply to a customer/lead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "messageText"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "messageText": {
                    "type": "string"
                  },
                  "conversationId": {
                    "type": "string"
                  },
                  "recipientHandle": {
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message dispatch status"
          }
        }
      }
    },
    "/api/commander/rules": {
      "get": {
        "operationId": "listAutoReplyRules",
        "summary": "List active automated trigger and auto-reply rules",
        "responses": {
          "200": {
            "description": "List of rules"
          }
        }
      },
      "post": {
        "operationId": "createAutoReplyRule",
        "summary": "Create or update an automated trigger/auto-reply rule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "ruleType",
                  "triggerMatch",
                  "responseTemplate"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "ruleType": {
                    "type": "string"
                  },
                  "triggerMatch": {
                    "type": "string"
                  },
                  "actionType": {
                    "type": "string"
                  },
                  "responseTemplate": {
                    "type": "string"
                  },
                  "aiInstructions": {
                    "type": "string"
                  },
                  "cooldownSeconds": {
                    "type": "integer"
                  },
                  "dailyMaxTriggers": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule created"
          }
        }
      }
    },
    "/api/commander/campaigns": {
      "get": {
        "operationId": "listGrowthCampaigns",
        "summary": "List active growth/automation campaigns (FollowLiker/MassPlanner style)",
        "responses": {
          "200": {
            "description": "Campaign list"
          }
        }
      },
      "post": {
        "operationId": "createGrowthCampaign",
        "summary": "Create a new growth automation campaign",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "platform",
                  "campaignType"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "campaignType": {
                    "type": "string"
                  },
                  "targetCriteria": {
                    "type": "object"
                  },
                  "dailyLimits": {
                    "type": "object"
                  },
                  "minDelaySeconds": {
                    "type": "integer"
                  },
                  "maxDelaySeconds": {
                    "type": "integer"
                  },
                  "accountId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created campaign"
          }
        }
      }
    },
    "/api/commander/activity": {
      "get": {
        "operationId": "getActivityLog",
        "summary": "View audit trail of all automated actions and API calls",
        "responses": {
          "200": {
            "description": "Activity log list"
          }
        }
      }
    },
    "/api/commander/limits": {
      "get": {
        "operationId": "checkPlatformLimits",
        "summary": "Check daily quotas, cooldowns, and anti-ban safe mode",
        "responses": {
          "200": {
            "description": "Rate limits and status"
          }
        }
      }
    }
  }
}